# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings → API). Use somente a chave pública (anon/publishable).
# NUNCA coloque a service_role key em variáveis VITE_* — elas vão para o navegador.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-publica
